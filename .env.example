# Optional shell environment; no credentials exist or are required.
# This file is NOT automatically loaded. Export values in the shell or use TOML.
BTC5M_LIVE=false
BTC5M_RUNTIME_DIR=runtime
# 仅观测：权益快照间隔和独立CLOB估值报价新鲜度（秒，必须为有限正数）。
# 不影响信号、风险预算、撮合参数或交易盘口；缺失/过期市值记null。
BTC5M_EQUITY_SNAPSHOT_SECONDS=15
BTC5M_VALUATION_STALE_SECONDS=5
BTC5M_INITIAL_CASH=1000
BTC5M_MAX_TRADE=10
BTC5M_MAX_EXPOSURE=50
BTC5M_DAILY_LOSS_LIMIT=20
BTC5M_MAX_CONSECUTIVE_LOSSES=3
# 每个5分钟窗口成功成交次数，跨方向/结算/重启累计；拒绝不占额度。
BTC5M_MAX_ENTRIES_PER_WINDOW=1
# 只自动恢复 abnormal_spread / stale_or_disconnected_book；亏损熔断必须手动恢复。
BTC5M_MARKET_AUTO_RECOVERY=true
BTC5M_MARKET_RECOVERY_SNAPSHOTS=3
BTC5M_MARKET_RECOVERY_COOLDOWN=30
BTC5M_SHARES=5
# Paper-only conservative stress multiplier >=1; official schedule validation stays 0.07.
BTC5M_PAPER_FEE_MULTIPLIER=1
BTC5M_SIGNAL_THRESHOLD=0.03
BTC5M_MIN_MOMENTUM=0.03
BTC5M_MAX_ENTRY_PRICE=0.85
BTC5M_MAX_SPREAD=0.05
BTC5M_MAX_SLIPPAGE=0.02
BTC5M_STALE_SECONDS=5
BTC5M_MIN_TIME_REMAINING=30
BTC5M_DISCOVERY_SECONDS=5
BTC5M_RESOLUTION_SECONDS=15
BTC5M_HTTP_TIMEOUT=10
BTC5M_RETRY_INITIAL=1
BTC5M_RETRY_MAX=30
BTC5M_HEARTBEAT_SECONDS=10
BTC5M_PONG_TIMEOUT=20
